{
  "name": "visionbridge-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless WebSocket relay for pairing the VisionBridge VR simulation device with a doctor controller device.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "schema:generate": "tsx scripts/generateSchema.ts",
    "schema:check": "tsx scripts/generateSchema.ts --check",
    "discovery:key": "tsx scripts/generateDiscoveryKey.ts",
    "endpoint": "tsx scripts/endpoint.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.12",
    "eslint": "^9.39.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.0.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "engines": {
    "node": ">=18"
  }
}
